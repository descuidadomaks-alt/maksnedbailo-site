# oh4 lead-capture fan-out — see app/api/lead/route.ts for 3-step setup
# instructions for each of these. Every integration no-ops (console.warn,
# doesn't throw) if its vars are left blank.

# Google Sheet logging (Apps Script web app URL)
GAS_WEBHOOK_URL=

# Telegram instant alert
TG_BOT_TOKEN=
TG_CHAT_ID=

# Email via Resend
RESEND_API_KEY=
NOTIFY_EMAILS=

# Care Less — UK locksmith missed-calls campaign lead-capture fan-out — see
# app/api/missed-calls-lead/route.ts for setup instructions. Reuses
# TG_BOT_TOKEN/TG_CHAT_ID above; everything else is its own.

# Separate Google Sheet from the oh4 one above
GAS_WEBHOOK_URL_MISSED_CALLS=

# Meta leadgen webhook (Page Access Token + your chosen verify token)
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=
